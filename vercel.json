{
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SECRET_KEY": "@DJANGO_SECRET_KEY",
    "DJANGO_DEBUG": "False",
    "ALLOWED_HOSTS": ".vercel.app"
  }
}
