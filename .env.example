# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-change-this
DJANGO_DEBUG=False
ALLOWED_HOSTS=127.0.0.1,.vercel.app

# Database Configuration
# For PostgreSQL (production):
DATABASE_URL=postgresql://user:password@host:port/dbname
# For SQLite (development - uses db.sqlite3 if DATABASE_URL is not set):
# Leave DATABASE_URL unset or commented out to use SQLite

# Superuser Configuration (for production - auto-created on deploy)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-password
